# ============================================================================
#  .env.production.example — قالب متغيرات الإنتاج لمنصة khaledsaad
#  استخدم: cp .env.production.example .env ثم عبّئ القيم الفعلية على الخادم
#  ⚠️ لا تُودع هذا الملف (أو أي ملف .env) داخل Git مع قيم حقيقية.
# ============================================================================

APP_NAME="منصة التسويق الاستراتيجي"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_TIMEZONE=Asia/Riyadh

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- السجلات ----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- قاعدة البيانات ---------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=khaledsaad_prod
DB_USERNAME=
DB_PASSWORD=

# --- الجلسة / الطابور / الكاش ----------------------------------------------
# Redis مُوصى به للإنتاج؛ عند عدم توفّره استخدم database.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- البريد (إلزامي للإنتاج) ------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- التخزين الخارجي (اختياري) ----------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- المدير الأول (يُستخدم عند السيدينغ لأول مرة) --------------------------
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=

# --- الذكاء الاصطناعي -------------------------------------------------------
# AI_PROVIDER: gemini | nvidia | fallback
AI_PROVIDER=fallback

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

NVIDIA_API_KEY=
# NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# --- PayPal ------------------------------------------------------------------
# للإنتاج: live + معرّفات Plan حقيقية من PayPal Developer.
# لا تفعّل live بدون تعبئة كل الـ PAYPAL_PLAN_* المطلوبة.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_STARTER_MONTHLY=
PAYPAL_PLAN_STARTER_ANNUAL=
PAYPAL_PLAN_PRO_MONTHLY=
PAYPAL_PLAN_PRO_ANNUAL=
PAYPAL_PLAN_TEAM_MONTHLY=
PAYPAL_PLAN_TEAM_ANNUAL=
PAYPAL_PLAN_AGENCY_MONTHLY=
PAYPAL_PLAN_AGENCY_ANNUAL=
PAYPAL_PLAN_ENT_MONTHLY=
PAYPAL_PLAN_ENT_ANNUAL=

# --- تكامل HTTP سحابي (اختياري) --------------------------------------------
CLOUD_INTEGRATION_ENABLED=false
CLOUD_BASE_URL=
CLOUD_API_TOKEN=

# --- خلف Reverse Proxy (Nginx / Cloudflare) ---------------------------------
# إذا كان التطبيق خلف بروكسي، فعّل هذه لضبط الـ IP والبروتوكول الفعلي.
TRUSTED_PROXIES=*
TRUSTED_HOSTS=your-domain.com
