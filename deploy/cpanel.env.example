# ============================================================================
#  بيانات نشر cPanel عبر SSH/SFTP — انسخ هذا الملف إلى deploy/cpanel.env واملأه
#  (deploy/cpanel.env مستثنى من git ولن يُرفع أبداً)
# ============================================================================

# عنوان الخادم (اسم النطاق أو IP)
CPANEL_HOST=example.com

# منفذ SSH (غالباً 22، وبعض استضافات cPanel تستخدم منفذاً مخصصاً مثل 21098)
CPANEL_PORT=22

# اسم مستخدم cPanel/SSH
CPANEL_USER=kcepljda

# طريقة المصادقة: اختر واحدة فقط
# (أ) مسار مفتاح SSH خاص (الأفضل أماناً)
CPANEL_SSH_KEY=

# (ب) أو كلمة المرور (إن لم يتوفر مفتاح)
CPANEL_PASSWORD=

# المسار المطلق لجذر الموقع على الاستضافة
CPANEL_REMOTE_PATH=/home/kcepljda/public_html
