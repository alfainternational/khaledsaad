APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@khaledsaad.local
ADMIN_PASSWORD=Demo@123456

# Google AI (Gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TEMPERATURE=0.35
# GEMINI_MAX_OUTPUT_TOKENS=1024
# صقل نص الحكم/الملاحظة الاستراتيجية بعد التقييم المنظم (يتطلب مفتاحاً)
# AI_TOOL_ASSESSMENT_ENRICH_LLM=true

# NVIDIA NIM (OpenAI-compatible — https://build.nvidia.com)
NVIDIA_API_KEY=
# NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# AI_PROVIDER: gemini | nvidia | fallback (Gemini ثم NVIDIA عند الفشل)
AI_PROVIDER=gemini

# Structured local knowledge and outbound-only private intelligence worker
AI_KNOWLEDGE_HYBRID_RETRIEVAL=false
AI_KNOWLEDGE_CHUNKED_UPLOADS=false
AI_KNOWLEDGE_CHUNK_BYTES=1048576
AI_KNOWLEDGE_CHUNKED_MAX_BYTES=52428800
AI_KNOWLEDGE_CHUNK_SESSION_TTL_MINUTES=120
AI_KNOWLEDGE_STRUCTURED_EXTRACTION=false
AI_KNOWLEDGE_EMBEDDING_MODEL=nomic-embed-text
AI_KNOWLEDGE_EMBEDDING_MODEL_VERSION=v1
AI_KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
AI_KNOWLEDGE_EMBEDDING_CANDIDATE_LIMIT=200
AI_KNOWLEDGE_EMBEDDING_MIN_SIMILARITY=0.25
AI_KNOWLEDGE_EMBEDDING_QUERY_INSTRUCTION=
AI_KNOWLEDGE_LEXICAL_TERM_SCORE_CAP=3
AI_KNOWLEDGE_SEMANTIC_RANK_WEIGHT=400
AI_KNOWLEDGE_EMBEDDING_MIN_DIMENSIONS=2
AI_KNOWLEDGE_EMBEDDING_MAX_DIMENSIONS=4096
AI_KNOWLEDGE_QUERY_EMBEDDING_TTL_DAYS=7
AI_KNOWLEDGE_EVALUATION_MIN_RECALL=0.8
AI_KNOWLEDGE_EVALUATION_MIN_MRR=0.6
AI_PRIVATE_WORKER_ENABLED=false

# Verified web research (bounded for shared hosting; private SearXNG is optional)
AI_WEB_RESEARCH_ENABLED=false
AI_WEB_RESEARCH_REFRESH_ENABLED=false
AI_WEB_RESEARCH_MAX_RESULTS=8
AI_WEB_RESEARCH_MAX_FETCHES=3
AI_WEB_RESEARCH_MAX_RESPONSE_BYTES=2097152
AI_WEB_RESEARCH_FRESHNESS_DAYS=7
AI_WEB_RESEARCH_REFRESH_BATCH_SIZE=10
AI_WEB_RESEARCH_SEARXNG_URL=

# PayPal Subscriptions — نفس فكرة الموقع القديم (PayPalService + خطط Billing في لوحة PayPal)
# إن لم تُعرّف PAYPAL_ENABLED: يُفعّل الدفع تلقائياً عند وجود CLIENT_ID و CLIENT_SECRET. ضع false لتعطيل صريح.
# PAYPAL_ENABLED=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# معرفات خطط الاشتراك من PayPal Developer → Products & Plans (أو: php artisan paypal:list-plans)
# إن تركت STARTER أو TEAM فارغة: يُستخدم PRO تلقائياً (نفس منتج PayPal لعدة مستويات عرض)
PAYPAL_PLAN_STARTER_MONTHLY=
PAYPAL_PLAN_STARTER_ANNUAL=
PAYPAL_PLAN_PRO_MONTHLY=
PAYPAL_PLAN_PRO_ANNUAL=
PAYPAL_PLAN_TEAM_MONTHLY=
PAYPAL_PLAN_TEAM_ANNUAL=
PAYPAL_PLAN_AGENCY_MONTHLY=
PAYPAL_PLAN_AGENCY_ANNUAL=
# أسماء الموقع القديم — تُستخدم كبديل لباقة agency إذا لم تُضبط PAYPAL_PLAN_AGENCY_*
PAYPAL_PLAN_ENT_MONTHLY=
PAYPAL_PLAN_ENT_ANNUAL=

# تكامل اختياري مع خدمة HTTP خارجية (المجلد المحلي cloud ليس Laravel — انظر config/cloud.php)
CLOUD_INTEGRATION_ENABLED=false
CLOUD_BASE_URL=
CLOUD_API_TOKEN=
# CLOUD_TIMEOUT=10
# CLOUD_CONNECT_TIMEOUT=5
# CLOUD_HTTP_MAX_ATTEMPTS=3
# CLOUD_RETRY_DELAY_MS=200
# CLOUD_RATE_LIMIT_PER_MINUTE=60
# CLOUD_LOG_CHANNEL=stack
# CLOUD_EXPOSE_ERROR_DETAIL=false
# CLOUD_FEATURE_FLAG_KEY=integrations.cloud_http
# CLOUD_ENTITLEMENT_KEY=integrations.cloud_http
# CLOUD_ENFORCE_FEATURE_FLAG=true
# CLOUD_ENFORCE_ENTITLEMENT=true
